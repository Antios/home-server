#version=RHEL9

# Install mode
text
cdrom

# System language
lang en_CA.UTF-8
keyboard us

# Timezone
timezone America/Halifax --utc

# Root password (plaintext for now—fix later)
rootpw --iscrypted $ROOT_PASSWORD_HASH

# Create user
user --name=micomeau --password=$MICOMEAU_PASSWORD_HASH --iscrypted --groups=wheel

# Network
network --bootproto=dhcp --device=link --activate

# Install to first disk
zerombr
ignoredisk --only-use=nvme0n1
clearpart --all --initlabel --drives=nvme0n1
part /boot/efi --fstype=efi --size=600 --ondisk=nvme0n1
part /boot --fstype=xfs --size=1024 --ondisk=nvme0n1
part pv.01 --size=1 --grow --ondisk=nvme0n1

volgroup vg0 pv.01
logvol / --vgname=vg0 --name=root --fstype=xfs --size=8192 --grow

bootloader --location=partition --boot-drive=nvme0n1

# Packages
%packages
@^minimal-environment
qemu-kvm
libvirt
virt-install
%end

# Post-install
%post
systemctl enable libvirtd
%end
