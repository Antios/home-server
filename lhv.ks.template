#version=RHEL9

# Install mode
text
cdrom

# System language
lang en_CA.UTF-8
keyboard us

# Timezone
timezone America/Halifax --utc

# Root password (plaintext for now—fix later)
rootpw --iscrypted $ROOT_PASSWORD_HASH

# Create user
user --name=micomeau --password=$MICOMEAU_PASSWORD_HASH --iscrypted --groups=wheel

# Network
network --bootproto=dhcp --device=link --activate

# Install to first disk
ignoredisk --only-use=/dev/nvme0n1
clearpart --all --initlabel --drives=/dev/nvme0n1
zerombr

autopart --type=lvm -fstype=xfs

# Bootloader
bootloader --location=mbr

# Packages
%packages
@^minimal-environment
qemu-kvm
libvirt
virt-install
%end

# Post-install
%post
systemctl enable libvirtd
%end
